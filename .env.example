# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (SRV format). Replace <user> and <password>.
# Database name "doctor_tracker" is created automatically on first write.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be DIFFERENT values. Never commit the real ones.
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── Cookies & CORS ───────────────────────────────────────────────────────
# Only used when the frontend talks to the API directly (local dev without the
# Next.js rewrite proxy). In production the rewrite makes requests same-origin.
CLIENT_ORIGIN=http://localhost:3000
# Optional. Defaults to true when NODE_ENV=production and false otherwise, so
# the deployed API does not need this set. Override only to force a value.
# COOKIE_SECURE=true

# ─── Seed script (npm run seed) ───────────────────────────────────────────
# Quote any value containing `#`: dotenv ends an unquoted value at the first
# `#`, which silently hands the seed a two-character password.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.dev
ADMIN_PASSWORD="Admin@1234"
# Doctor count is not configurable — the seed only writes the verified records in
# src/data/doctorDirectory.ts, so it always inserts all of them.
SEED_PATIENTS=600
